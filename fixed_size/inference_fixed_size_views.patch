 _create_standalone_context = moderngl.create_standalone_context
 
+RENDER_VIEW = "front"
+RENDER_DISTANCE = 3.0
+
+
+def make_fixed_view_camera(target):
+    """Create a horizontal camera for trajectories whose vertical axis is Z."""
+    offsets = {
+        "front": np.array([0.0, -RENDER_DISTANCE, 0.0]),
+        "back": np.array([0.0, RENDER_DISTANCE, 0.0]),
+        "left": np.array([-RENDER_DISTANCE, 0.0, 0.0]),
+        "right": np.array([RENDER_DISTANCE, 0.0, 0.0]),
+    }
+    return PinholeCamera(target + offsets[RENDER_VIEW], target, w, h,
+                         world_up=[0.0, 0.0, -1.0], viewer=viewer)
+
 
